# Application Environment
APP_ENV=dev
APP_DEBUG=true

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eventsapi
DB_USER=eventsapi
DB_PASSWORD=eventsapi_pass

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=10

# Helioviewer Coordinator
HV_COORDINATOR_URL=https://api.helioviewer.org/coordinate

# Logging
LOG_LEVEL=DEBUG

# API URL for storage access
APIURL=https://events.helioviewer.org/

# Scheduler Configuration
SCHEDULER_ENABLED=false

# Production Docker Configuration (for production.yml)
# VIRTUAL_HOST=
# LETSENCRYPT_HOST=
# LETSENCRYPT_EMAIL=

# Application Environment
APP_ENV=dev
APP_DEBUG=true

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eventsapi
DB_USER=eventsapi
DB_PASSWORD=eventsapi_pass

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=10

# Helioviewer Coordinator
HV_COORDINATOR_URL=https://api.helioviewer.org/coordinate

# In-stack fallback, used when the primary coordinator is unreachable.
# The port matters: coordinator 3.2.0 listened on 80, 4.0.0 listens on 8000.
HV_COORDINATOR_FALLBACK_URL=http://coordinator:8000

# Coordinator calls one movie request sends at once (default 8). The primary
# is another machine; calls that fall back to the in-stack one go one at a time.
COORDINATOR_CONCURRENCY=8

# Logging
LOG_LEVEL=INFO

# API URL for storage access
APIURL=https://events.helioviewer.org/

# Scheduler Configuration
SCHEDULER_ENABLED=false

# Sentry Error Reporting
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.0

# Docker Configuration
# UID=
# GID=

# Production Docker Configuration (for production.yml)
# VIRTUAL_HOST=
# LETSENCRYPT_HOST=
# LETSENCRYPT_EMAIL=

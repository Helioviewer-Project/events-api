# Composer
/vendor/
composer.phar

# Environment files
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
/logs/

# Cache directories
/cache/
/tmp/

# Build artifacts
/build/
/dist/

# Storage - fully ignored so git status can prune the (million-file) tree.
# The structural .gitkeep files are already tracked and stay tracked.
/storage/

# Local DB dumps
/backups/

# Working reports and scratch scripts served from public/. They live there to be
# web-accessible, not because they are part of the app. The negations keep the
# app's own pages tracked — gitignore cannot untrack them anyway, but they say
# which files are deliberate.
public/*.html
public/*.php.txt
!public/failures.html
!public/stats.html
